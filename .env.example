WEB3_RPC_ENDPOINTS=https://infura.io/v3/<key>
# Or a path to a file with the same comma separated list (takes priority over WEB3_RPC_ENDPOINTS)
# WEB3_RPC_ENDPOINTS_FILE=/run/secrets/web3-rpc-endpoints

# Account private key. Without it the bot runs in dry mode
# WALLET_PRIVATE_KEY=0x0
# Or a path to a file with the key (takes priority over WALLET_PRIVATE_KEY; an empty file means dry mode)
# WALLET_PRIVATE_KEY_FILE=/run/secrets/wallet-private-key

# Node Operator Registry address (https://docs.lido.fi/deployed-contracts/)
# Mainnet: 0x55032650b14df07b85bF18A3a3eC8E0Af2e028d5,0xaE7B191A31f627b4eB1d4DaC64eaB9976995b433
NODE_OPERATOR_REGISTRY_ADDRESSES=0xaE7B191A31f627b4eB1d4DaC64eaB9976995b433,0x55032650b14df07b85bF18A3a3eC8E0Af2e028d5

# stETH token address (https://docs.lido.fi/deployed-contracts/)
# Mainnet: 0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84
STETH_ADDRESS=0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84
